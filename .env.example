# Copie este arquivo para ".env" e preencha com sua chave real.
# A chave da API da Anthropic você pega em https://console.anthropic.com
ANTHROPIC_API_KEY=sua_chave_aqui

# Opcional: usado para assinar o cookie de sessão do login de corretores.
# Se não definir, usa um valor padrão de desenvolvimento (troque em produção).
SESSION_SECRET=troque_por_uma_string_aleatoria

# String de conexão do Postgres. Localmente: banco na sua máquina ou um
# banco free de dev (ex. Neon). Em produção: a "Internal Database URL" que
# o Render gera quando você cria o Postgres do projeto.
DATABASE_URL=postgres://usuario:senha@localhost:5432/leadmatch
